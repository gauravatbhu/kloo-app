{
  "$schema": "kloo-design-tokens/v1",
  "$description": "Kloo design system v1. Dark-first, one warm accent, flat. Source of truth: the approved screen designs (2026-10). Colour values are sRGB hex. Sizes are in pt (iOS) and dp/sp (Android); 1 design px = 1 pt = 1 dp. Contrast ratios are WCAG 2.x relative-luminance ratios, computed for every text/background pair in contrastAudit.",
  "version": "1.0.0",

  "color": {
    "dark": {
      "$description": "Default theme. Values from the approved designs, except text.faint (changed for contrast, see contrastAudit) and the added line.control, focus.ring, accent.pressed and error tokens.",
      "bg": "#0D0D0F",
      "surface": {
        "1": "#151517",
        "2": "#17171A",
        "3": "#1C1C20"
      },
      "line": {
        "subtle": "#26262B",
        "strong": "#3A3A40",
        "control": "#6E6A64"
      },
      "text": {
        "primary": "#F4F1EC",
        "muted": "#A39E96",
        "faint": "#8A857E"
      },
      "icon": {
        "subtle": "#6E6A64"
      },
      "accent": {
        "fill": "#F0B45A",
        "pressed": "#D99A3E",
        "onFill": "#0D0D0F",
        "text": "#F0B45A"
      },
      "focus": {
        "ring": "#F0B45A"
      },
      "privacy": {
        "bg": "#15241F",
        "border": "#2E4A42",
        "ink": "#7FD1C0"
      },
      "resurface": {
        "bg": "#1B1724",
        "border": "#2D2640",
        "ink": "#C9C3F0"
      },
      "category": {
        "recipe":   { "bg": "#2A2015", "ink": "#F0B45A" },
        "travel":   { "bg": "#15241F", "ink": "#7FD1C0" },
        "fitness":  { "bg": "#261820", "ink": "#F29BB8" },
        "money":    { "bg": "#171C2A", "ink": "#9FB4F2" },
        "shopping": { "bg": "#1E1A28", "ink": "#C9C3F0" }
      },
      "error": {
        "bg": "#2A1717",
        "ink": "#F2A3A3"
      },
      "scrim": "rgba(0, 0, 0, 0.60)"
    },

    "light": {
      "$description": "Light theme for accessibility and user preference. Same roles as dark. Warm off-white, not pure white, to keep the calm feel. Accent fill stays amber with dark ink; amber is never used as text on light backgrounds (use accent.text).",
      "bg": "#FAF8F5",
      "surface": {
        "1": "#FFFFFF",
        "2": "#F3F0EB",
        "3": "#ECE8E1"
      },
      "line": {
        "subtle": "#E2DDD5",
        "strong": "#C9C2B8",
        "control": "#858079"
      },
      "text": {
        "primary": "#1A1917",
        "muted": "#5E5A54",
        "faint": "#67635D"
      },
      "icon": {
        "subtle": "#858079"
      },
      "accent": {
        "fill": "#F0B45A",
        "pressed": "#D99A3E",
        "onFill": "#0D0D0F",
        "text": "#8A5A10"
      },
      "focus": {
        "ring": "#8A5A10"
      },
      "privacy": {
        "bg": "#E3F2EE",
        "border": "#A9D3C8",
        "ink": "#1E6B5C"
      },
      "resurface": {
        "bg": "#EFECF8",
        "border": "#D6D0EE",
        "ink": "#4A3F8C"
      },
      "category": {
        "recipe":   { "bg": "#F8EBD6", "ink": "#8A5A10" },
        "travel":   { "bg": "#E3F2EE", "ink": "#1E6B5C" },
        "fitness":  { "bg": "#F9E4EB", "ink": "#9A2F57" },
        "money":    { "bg": "#E6EBF8", "ink": "#2F4A9A" },
        "shopping": { "bg": "#EFECF8", "ink": "#4A3F8C" }
      },
      "error": {
        "bg": "#F9E3E1",
        "ink": "#A3302F"
      },
      "scrim": "rgba(26, 25, 23, 0.45)"
    },

    "usageRules": [
      "One accent. Amber is for the single primary action on a screen, focus rings, and the recipe category. Never two amber buttons on one screen.",
      "Teal (privacy) is only for true, tested privacy statements and success states. Never decorative.",
      "Plum (resurface) is only for resurfaced saves. Never for ads.",
      "text.faint may sit on bg, surface.1-3 and resurface.bg only. On privacy.bg and category tints use text.muted or the tint's own ink (faint fails 4.5:1 there in dark theme).",
      "icon.subtle (#6E6A64 dark) is for non-essential icons and control borders only, never for text.",
      "line.subtle and line.strong are decorative dividers. Any border that is the only thing showing where a control is (ask bar, text fields, checkboxes) uses line.control (3:1 or better).",
      "Category is never shown by colour alone: the category name or icon is always present."
    ]
  },

  "typography": {
    "families": {
      "sans": { "name": "Manrope", "weights": [400, 500, 600, 700, 800], "fallbackIOS": "SF Pro", "fallbackAndroid": "Roboto" },
      "mono": { "name": "DM Mono", "weights": [400, 500], "fallbackIOS": "SF Mono", "fallbackAndroid": "Roboto Mono" }
    },
    "scale": {
      "display":    { "family": "sans", "size": 40, "lineHeight": 44, "weight": 800, "letterSpacing": "-0.03em", "iosTextStyle": "largeTitle", "androidRole": "displaySmall", "use": "Welcome headline only" },
      "headline":   { "family": "sans", "size": 32, "lineHeight": 36, "weight": 800, "letterSpacing": "-0.03em", "iosTextStyle": "largeTitle", "androidRole": "headlineLarge", "use": "Onboarding and paywall headlines" },
      "title":      { "family": "sans", "size": 28, "lineHeight": 32, "weight": 800, "letterSpacing": "-0.03em", "iosTextStyle": "title1", "androidRole": "headlineMedium", "use": "Screen titles (Home, Ask, Act)" },
      "titleSmall": { "family": "sans", "size": 20, "lineHeight": 26, "weight": 700, "letterSpacing": "-0.01em", "iosTextStyle": "title3", "androidRole": "titleLarge", "use": "Sheet titles, section headings" },
      "cardTitle":  { "family": "sans", "size": 16, "lineHeight": 22, "weight": 700, "letterSpacing": "-0.005em", "iosTextStyle": "headline", "androidRole": "titleMedium", "use": "Reel card titles, list item titles" },
      "bodyLarge":  { "family": "sans", "size": 16, "lineHeight": 24, "weight": 400, "letterSpacing": "0", "iosTextStyle": "body", "androidRole": "bodyLarge", "use": "Answers, onboarding body" },
      "body":       { "family": "sans", "size": 15, "lineHeight": 22, "weight": 400, "letterSpacing": "0", "iosTextStyle": "callout", "androidRole": "bodyMedium", "use": "Default body" },
      "button":     { "family": "sans", "size": 16, "lineHeight": 20, "weight": 700, "letterSpacing": "0", "iosTextStyle": "headline", "androidRole": "labelLarge", "use": "Button labels" },
      "caption":    { "family": "sans", "size": 13, "lineHeight": 18, "weight": 500, "letterSpacing": "0", "iosTextStyle": "footnote", "androidRole": "bodySmall", "use": "Metadata, helper text" },
      "captionSmall": { "family": "sans", "size": 12.5, "lineHeight": 17, "weight": 500, "letterSpacing": "0", "iosTextStyle": "caption1", "androidRole": "labelMedium", "use": "Secondary metadata. Smallest sans size allowed." },
      "label":      { "family": "mono", "size": 11, "lineHeight": 14, "weight": 500, "letterSpacing": "0.12em", "textTransform": "uppercase", "iosTextStyle": "caption2", "androidRole": "labelSmall", "use": "Status labels, section eyebrows, Ad label, counts" }
    },
    "rules": [
      "All sizes scale with Dynamic Type (iOS, via UIFontMetrics / .font(.custom(_:size:relativeTo:))) and font scale (Android, sp units). Never fixed.",
      "Support up to iOS AX5 and Android 200% font scale. At accessibility sizes, button rows stack vertically and cards grow in height; nothing truncates mid-word except reel titles (2 lines, then ellipsis, full title in the accessibility label).",
      "DM Mono labels are uppercase visually only; the accessibility label uses sentence case so screen readers do not spell them out.",
      "Minimum text colour for label (11 pt mono) is text.muted, never text.faint."
    ]
  },

  "spacing": {
    "$description": "4-based scale, 8 as the main rhythm.",
    "0": 0,
    "1": 2,
    "2": 4,
    "3": 8,
    "4": 12,
    "5": 16,
    "6": 20,
    "7": 24,
    "8": 32,
    "9": 40,
    "10": 48,
    "11": 64,
    "screenGutter": 20,
    "cardPadding": 16,
    "sectionGap": 32,
    "stackGap": 12
  },

  "radius": {
    "xs": 8,
    "sm": 12,
    "md": 14,
    "lg": 18,
    "xl": 20,
    "2xl": 24,
    "3xl": 28,
    "use": {
      "xs": "Thumbnails inside cards, checkbox",
      "sm": "Status labels, small tags, toast",
      "md": "List rows, collection tiles",
      "lg": "Buttons, chips (36 pt tall, so fully rounded), ask bar",
      "xl": "Reel result cards, ad card",
      "2xl": "Resurfaced card, privacy panel",
      "3xl": "Bottom sheets (top corners only)"
    }
  },

  "size": {
    "touchTargetMin": { "ios": 44, "android": 48 },
    "button": { "minHeight": 56, "range": [54, 58], "radius": "lg" },
    "chip": { "visualHeight": 36, "hitHeight": 48 },
    "askBar": { "minHeight": 56 },
    "icon": { "sm": 16, "md": 20, "lg": 24 },
    "focusRing": { "width": 2, "offset": 2 }
  },

  "elevation": {
    "$description": "None. Kloo is flat. Layering comes from surface colour steps (bg < surface.1 < surface.2 < surface.3) and 1 pt lines. No drop shadows in either theme.",
    "level0": { "surface": "bg", "shadow": "none" },
    "level1": { "surface": "surface.1", "shadow": "none" },
    "level2": { "surface": "surface.2", "shadow": "none" },
    "level3": { "surface": "surface.3", "shadow": "none", "border": "1pt line.strong on the top edge for sheets" },
    "overlay": { "scrim": "scrim", "shadow": "none" }
  },

  "motion": {
    "duration": {
      "instant": 0,
      "fast": 120,
      "base": 200,
      "sheet": 280,
      "slow": 320
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "use": {
      "pressFeedback": "fast, standard; colour change plus scale 0.98",
      "chipSelect": "fast",
      "toastInOut": "base",
      "sheetPresent": "sheet, enter; dismiss uses exit",
      "findabilityMeterFill": "slow, segments fill left to right",
      "screenTransition": "platform default"
    },
    "reducedMotion": {
      "$description": "When iOS Reduce Motion or Android 'Remove animations' is on.",
      "rules": [
        "No scale, slide or parallax. Replace with an opacity crossfade of at most 120 ms, or no animation.",
        "Sheets appear with a fade, not a slide.",
        "The findability meter shows its final state at once.",
        "No auto-playing video previews or looping thumbnails anywhere.",
        "Progress indicators stay (they carry meaning) but use a static or stepped style instead of shimmer."
      ]
    }
  },

  "contrastAudit": {
    "$description": "WCAG 2.x ratios. Text needs 4.5:1 (PRINCIPLES.md 15). Control boundaries and focus rings need 3:1 (WCAG 1.4.11). Ratios computed by hand from sRGB relative luminance; engineers should re-check in CI with a contrast linter.",
    "failuresFound": [
      {
        "pair": "dark text.faint #6E6A64 on bg #0D0D0F / surface.1 #151517 / surface.2 #17171A / surface.3 #1C1C20",
        "ratio": "3.61 / 3.39 / 3.33 / 3.16",
        "fix": "text.faint changed to #8A857E (5.30 / 4.98 / 4.89 / 4.64). #6E6A64 kept only as icon.subtle and line.control, where 3:1 applies."
      },
      {
        "pair": "dark text.faint #8A857E (after fix) on privacy.bg #15241F and category tints",
        "ratio": "4.40 on #15241F, 4.36 on #2A2015",
        "fix": "Usage rule: no faint text on privacy or category tints. Use text.muted (6.05 on #15241F, 5.99 on #2A2015) or the tint ink."
      },
      {
        "pair": "dark line.subtle #26262B and line.strong #3A3A40 as the only boundary of the ask bar or other inputs, on bg",
        "ratio": "1.29 / 1.72 (needs 3:1)",
        "fix": "Added line.control #6E6A64 (3.61 on bg, 3.16 on surface.3) for input and checkbox borders. line.subtle/strong remain for decorative dividers and card edges."
      },
      {
        "pair": "light theme: amber #F0B45A as text or focus ring on light backgrounds",
        "ratio": "1.74 on #FAF8F5",
        "fix": "Added light accent.text and focus.ring #8A5A10 (5.58 on bg, 4.84 on surface.3). Amber stays as a fill with dark ink."
      },
      {
        "pair": "light theme: #6E6A64 as faint text on surface.3 #ECE8E1",
        "ratio": "4.40",
        "fix": "Light text.faint is #67635D (4.89 on surface.3, 5.63 on bg)."
      },
      {
        "pair": "light theme: #8A857E as control border on surface.3 #ECE8E1",
        "ratio": "3.00 (borderline)",
        "fix": "Light line.control is #858079 (3.21 on surface.3, 3.70 on bg)."
      }
    ],
    "darkPairs": [
      { "fg": "text.primary #F4F1EC", "bg": "bg #0D0D0F", "ratio": 17.23, "pass": true },
      { "fg": "text.primary #F4F1EC", "bg": "surface.1 #151517", "ratio": 16.19, "pass": true },
      { "fg": "text.primary #F4F1EC", "bg": "surface.2 #17171A", "ratio": 15.88, "pass": true },
      { "fg": "text.primary #F4F1EC", "bg": "surface.3 #1C1C20", "ratio": 15.08, "pass": true },
      { "fg": "text.primary #F4F1EC", "bg": "resurface.bg #1B1724", "ratio": 15.60, "pass": true },
      { "fg": "text.primary #F4F1EC", "bg": "category.recipe.bg #2A2015", "ratio": 14.17, "pass": true },
      { "fg": "text.muted #A39E96", "bg": "bg #0D0D0F", "ratio": 7.29, "pass": true },
      { "fg": "text.muted #A39E96", "bg": "surface.1 #151517", "ratio": 6.85, "pass": true },
      { "fg": "text.muted #A39E96", "bg": "surface.2 #17171A", "ratio": 6.72, "pass": true },
      { "fg": "text.muted #A39E96", "bg": "surface.3 #1C1C20", "ratio": 6.38, "pass": true },
      { "fg": "text.muted #A39E96", "bg": "resurface.bg #1B1724", "ratio": 6.60, "pass": true },
      { "fg": "text.muted #A39E96", "bg": "privacy.bg #15241F", "ratio": 6.05, "pass": true },
      { "fg": "text.muted #A39E96", "bg": "category.recipe.bg #2A2015", "ratio": 5.99, "pass": true },
      { "fg": "text.faint #8A857E (fixed)", "bg": "bg #0D0D0F", "ratio": 5.30, "pass": true },
      { "fg": "text.faint #8A857E (fixed)", "bg": "surface.3 #1C1C20", "ratio": 4.64, "pass": true },
      { "fg": "text.faint #8A857E (fixed)", "bg": "resurface.bg #1B1724", "ratio": 4.80, "pass": true },
      { "fg": "accent.onFill #0D0D0F", "bg": "accent.fill #F0B45A", "ratio": 10.52, "pass": true },
      { "fg": "accent.onFill #0D0D0F", "bg": "accent.pressed #D99A3E", "ratio": 7.99, "pass": true },
      { "fg": "accent.text #F0B45A", "bg": "surface.3 #1C1C20", "ratio": 9.21, "pass": true },
      { "fg": "privacy.ink #7FD1C0", "bg": "privacy.bg #15241F", "ratio": 9.04, "pass": true },
      { "fg": "privacy.ink #7FD1C0", "bg": "bg #0D0D0F", "ratio": 10.90, "pass": true },
      { "fg": "resurface.ink #C9C3F0", "bg": "resurface.bg #1B1724", "ratio": 10.50, "pass": true },
      { "fg": "category.recipe.ink #F0B45A", "bg": "#2A2015", "ratio": 8.65, "pass": true },
      { "fg": "category.travel.ink #7FD1C0", "bg": "#15241F", "ratio": 9.04, "pass": true },
      { "fg": "category.fitness.ink #F29BB8", "bg": "#261820", "ratio": 8.23, "pass": true },
      { "fg": "category.money.ink #9FB4F2", "bg": "#171C2A", "ratio": 8.32, "pass": true },
      { "fg": "category.shopping.ink #C9C3F0", "bg": "#1E1A28", "ratio": 10.17, "pass": true },
      { "fg": "error.ink #F2A3A3", "bg": "bg #0D0D0F", "ratio": 9.75, "pass": true },
      { "fg": "error.ink #F2A3A3", "bg": "error.bg #2A1717", "ratio": 8.55, "pass": true },
      { "fg": "focus.ring #F0B45A (non-text, 3:1)", "bg": "bg #0D0D0F", "ratio": 10.52, "pass": true },
      { "fg": "line.control #6E6A64 (non-text, 3:1)", "bg": "surface.3 #1C1C20", "ratio": 3.16, "pass": true }
    ],
    "lightPairs": [
      { "fg": "text.primary #1A1917", "bg": "bg #FAF8F5", "ratio": 16.57, "pass": true },
      { "fg": "text.primary #1A1917", "bg": "surface.3 #ECE8E1", "ratio": 14.39, "pass": true },
      { "fg": "text.primary #1A1917", "bg": "resurface.bg #EFECF8", "ratio": 15.08, "pass": true },
      { "fg": "text.muted #5E5A54", "bg": "bg #FAF8F5", "ratio": 6.46, "pass": true },
      { "fg": "text.muted #5E5A54", "bg": "surface.3 #ECE8E1", "ratio": 5.61, "pass": true },
      { "fg": "text.muted #5E5A54", "bg": "category.fitness.bg #F9E4EB", "ratio": 5.65, "pass": true },
      { "fg": "text.faint #67635D", "bg": "bg #FAF8F5", "ratio": 5.63, "pass": true },
      { "fg": "text.faint #67635D", "bg": "surface.3 #ECE8E1", "ratio": 4.89, "pass": true },
      { "fg": "accent.onFill #0D0D0F", "bg": "accent.fill #F0B45A", "ratio": 10.52, "pass": true },
      { "fg": "accent.text #8A5A10", "bg": "bg #FAF8F5", "ratio": 5.58, "pass": true },
      { "fg": "accent.text #8A5A10", "bg": "surface.3 #ECE8E1", "ratio": 4.84, "pass": true },
      { "fg": "privacy.ink #1E6B5C", "bg": "privacy.bg #E3F2EE", "ratio": 5.49, "pass": true },
      { "fg": "privacy.ink #1E6B5C", "bg": "bg #FAF8F5", "ratio": 5.98, "pass": true },
      { "fg": "resurface.ink #4A3F8C", "bg": "resurface.bg #EFECF8", "ratio": 7.57, "pass": true },
      { "fg": "category.recipe.ink #8A5A10", "bg": "#F8EBD6", "ratio": 5.03, "pass": true },
      { "fg": "category.travel.ink #1E6B5C", "bg": "#E3F2EE", "ratio": 5.49, "pass": true },
      { "fg": "category.fitness.ink #9A2F57", "bg": "#F9E4EB", "ratio": 5.94, "pass": true },
      { "fg": "category.money.ink #2F4A9A", "bg": "#E6EBF8", "ratio": 6.86, "pass": true },
      { "fg": "category.shopping.ink #4A3F8C", "bg": "#EFECF8", "ratio": 7.57, "pass": true },
      { "fg": "error.ink #A3302F", "bg": "bg #FAF8F5", "ratio": 6.56, "pass": true },
      { "fg": "error.ink #A3302F", "bg": "error.bg #F9E3E1", "ratio": 5.66, "pass": true },
      { "fg": "focus.ring #8A5A10 (non-text, 3:1)", "bg": "bg #FAF8F5", "ratio": 5.58, "pass": true },
      { "fg": "line.control #858079 (non-text, 3:1)", "bg": "surface.3 #ECE8E1", "ratio": 3.21, "pass": true }
    ]
  }
}
